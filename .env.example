# LLM provider: "google" or "groq"
LLM_PROVIDER=google

# Gemini Developer API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Free API key: https://console.groq.com/keys
GROQ_API_KEY=

# Groq fallback/provider configuration
# Keep reasoning disabled for short child-facing replies.
GROQ_MODEL=openai/gpt-oss-20b
# Optional: cheaper model for turn records. Defaults to GROQ_MODEL.
# EXTRACT_MODEL=openai/gpt-oss-20b
# Per-minute input token budget used by the call queue (hosted free tier: 7000).
# LLM_ITPM=6000
# Output cap for the tutor's replies (default: 256).
# LLM_MAX_TOKENS=256
# "low" for reasoning models, "none" for non-reasoning ones (default: none).
# LLM_REASONING_EFFORT=low

# Deepgram: cloud speech recognition fallback and the hosted teaching voice
DEEPGRAM_API_KEY=

# Hosted teaching voice for speech output (Deepgram Aura-2)
DEEPGRAM_TTS_VOICE=aura-2-helena-en

# MongoDB Atlas connection string. Parent accounts and profiles require MongoDB.
# The value must include the mongodb:// or mongodb+srv:// prefix.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=elt
